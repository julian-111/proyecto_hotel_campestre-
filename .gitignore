# Ignorar carpetas de dependencias de Node.js
node_modules/
backend/node_modules/
frontend/node_modules/

# Ignorar archivos temporales y de caché de Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
env.bak/
venv.bak/

# Ignorar variables de entorno y archivos secretos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignorar archivos del sistema operativo
.DS_Store
Thumbs.db

# Ignorar archivos de logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
